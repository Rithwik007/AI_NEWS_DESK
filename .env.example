# New personal desk defaults. Choose clerk or none, and mongodb or sqlite independently.
AUTH_MODE=none
DATABASE_MODE=sqlite
# SQLite file (relative to the backend working directory)
SQLITE_PATH=./data/newsdesk.sqlite
MONGODB_URI=mongodb://127.0.0.1:27017/ai_news
PORT=3000
# Enable on your single delivery host once your own channels are ready.
DISABLE_SCHEDULER=true
FRONTEND_URL=http://localhost:5173
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GROQ_API_KEY=
# Optional additional Groq keys for failover
API_2=
API_3=
API_4=
API_5=
# Optional backend crash reporting
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
# Optional override. The default is derived from the bot token.
TELEGRAM_WEBHOOK_SECRET=
# Full public HTTPS URL ending in /api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Optional manual pipeline trigger (POST with x-pipeline-secret)
PIPELINE_SECRET=
# Optional WhatsApp integration. Configure this group together.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ALLOWED_NUMBERS=
